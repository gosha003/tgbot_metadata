# Copy this file to .env (next to bot.py) and fill it in.
# .env never gets into the repository: it's in .gitignore. Never show your token to anyone.

# Your bot's token from @BotFather. Required.
TG_BOT_TOKEN=123456789:AAH...replace_with_yours

# Your Telegram user_id (a number). Required: without it the bot serves NOBODY.
# Don't know your id? Start the bot and send it anything; it replies with your id.
TG_OWNER_ID=

# Other people allowed to use the bot, comma-separated. Optional.
# TG_ALLOWED_IDS=111111111,222222222

# After how many minutes the bot deletes its own reports from the chat. 0 means never.
# Default: 60.
# REPORT_TTL_MIN=60

# Default language of the bot's replies: ru or en. Default: ru.
# Each user can switch with /lang; the choice is remembered.
# BOT_LANG=ru
