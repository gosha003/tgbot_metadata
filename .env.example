# Скопируйте этот файл в .env (рядом с bot.py) и заполните.
# .env в репозиторий не попадает: он в .gitignore. Никому не показывайте токен.

# Токен вашего бота от @BotFather. Обязательно.
TG_BOT_TOKEN=123456789:AAH...замените_на_свой

# Ваш Telegram user_id (число). Обязательно: без него бот не обслуживает НИКОГО.
# Не знаете свой id -- запустите бота и напишите ему что угодно, он ответит им.
TG_OWNER_ID=

# Ещё кому можно пользоваться ботом, через запятую. Необязательно.
# TG_ALLOWED_IDS=111111111,222222222

# Через сколько минут бот сам удаляет свои отчёты из чата. 0 -- не удалять.
# По умолчанию 60.
# REPORT_TTL_MIN=60
