# Bot token. Must never get into the history.
.env
*.env

# Single-instance lock of the bot.
.bot.lock

# Per-user language choice of the bot (/lang): local state, not source.
.bot_lang.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Optional external binaries (exiftool etc.) are downloaded by hand and not
# committed. .gitkeep keeps the directory itself.
tools/*
!tools/.gitkeep

# Temporary parsing files and drafts.
tmp/
scratch_*
*.tmp
