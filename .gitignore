# Токен бота. Никогда не должен попасть в историю.
.env
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Необязательные внешние бинарники (exiftool и прочее): качаются вручную,
# в репозиторий не кладутся. .gitkeep оставляет сам каталог.
tools/*
!tools/.gitkeep

# Временные файлы разбора и черновики агентов.
tmp/
scratch_*
*.tmp
