# Line endings in the repository are always LF, even when working on Windows:
# otherwise every commit from another machine produces a whole-file junk diff.
* text=auto eol=lf

# Leave binary fixtures and test samples alone.
*.doc  binary
*.xls  binary
*.ppt  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
